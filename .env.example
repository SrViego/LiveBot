# =============================================================================
# LiveBot — preenche e salva como .env
#   cp .env.example .env
#   nano .env   (ou o editor que preferir)
# =============================================================================
# NUNCA commita o .env (já está no .gitignore)
# =============================================================================


# ── 1) OBRIGATÓRIO — Chat Twitch ─────────────────────────────────────────────
# Nick da conta do BOT (pode ser a tua ou uma conta só-bot)
TWITCH_USERNAME=meubot

# Token de chat — TEM que começar com oauth:
# Como pegar (mais fácil):
#   https://twitchtokengenerator.com/  →  "Bot Chat Token"
#   marca: chat:read  chat:edit
#   (e se quiser follow/poll/pred, vê a secção 2)
TWITCH_OAUTH=oauth:cole_o_token_aqui

# Canal da live (teu nick de streamer, SEM #)
TWITCH_CHANNEL=meucanal


# ── 2) App Twitch (Client ID / Secret) ───────────────────────────────────────
# Cria em: https://dev.twitch.tv/console  →  Applications  →  Register
#   Name: LiveBot (ou o que quiser)
#   OAuth Redirect: http://localhost
#   Category: Application Integration
#
# Depois de criar a app:
#   Client ID     → cola em TWITCH_CLIENT_ID (o bot USA isso)
#   Client Secret → NÃO precisa no .env do bot
#                   (serve só se fores gerar token pela própria app OAuth;
#                    se usares twitchtokengenerator, o secret fica lá e pronto)
#
# Serve para: !so com last game, !poll, !pred, agradecer follows
TWITCH_CLIENT_ID=

# Scopes extras no token (se fores gerar token “custom” da tua app):
#   chat:read
#   chat:edit
#   moderator:read:followers          ← follows (bot tem que ser MOD do canal)
#   channel:manage:polls              ← !poll  (conta do streamer ou com permissão)
#   channel:manage:predictions        ← !pred
#
# ALERTS_FOLLOW=0
# POLL_DURATION_SEC=60
# PRED_DURATION_SEC=60


# ── 3) OBS Studio (só no PC da live) ─────────────────────────────────────────
# 1. OBS → Ferramentas → Definições do servidor WebSocket
# 2. Ativar servidor WebSocket
# 3. Porta 4455 (default) + define uma senha
# 4. Cenas: podes mapear em data/obs-scenes.json
#
# No outro PC (só chat): deixa OBS_ENABLED=0
OBS_ENABLED=0
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=
# Nome da source de texto no OBS que mostra o jogo atual (opcional)
OBS_GAME_TEXT_SOURCE=
# Cenas opcionais (senão usa data/obs-scenes.json)
# OBS_SCENE_BRB=BRB
# OBS_SCENE_LIVE=Live


# ── 4) PIX / doações ─────────────────────────────────────────────────────────
# Chave PIX, e-mail, ou link (LivePix, etc.)
PIX_KEY=

# Webhook local (opcional) — POST em http://127.0.0.1:PORTA/
# LIVEPIX_WEBHOOK_PORT=8787
# LIVEPIX_WEBHOOK_SECRET=
# LIVEPIX_ANNOUNCE_META=1


# ── 5) Comportamento do chat (opcional) ──────────────────────────────────────
COMMAND_PREFIX=!
COMMAND_COOLDOWN_MS=3000
USER_COOLDOWN_MS=5000

# JOIN_MESSAGE=✦ Live no ar · {jogo} · !comandos
# SILENT_JOIN=1
# FIRST_CHAT_GREET=1
# VISITOR_GREET=1
# ALERTS_DONATION_AUTO=1
# DONATION_THANK_COOLDOWN_MS=60000

# LIVEBOT_THEME=coral
# coral | void | pale | moss

# CLIP_REMINDER=1
# CLIP_REMINDER_MS=1800000
# CLIP_REMINDER_MSG=Clipa o momento se curtiu! 🎬

# DASHBOARD=1
# DASHBOARD_MS=15000
# SESSION_SUMMARY_CHAT=0

# DEBUG=0
