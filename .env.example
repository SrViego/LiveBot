# ── Twitch ──────────────────────────────────────────────
# 1) Conta do bot (pode ser a tua ou uma conta "bot")
# 2) https://twitchtokengenerator.com/  → Bot Chat Token
#    ou https://dev.twitch.tv/console  → app + token com chat:read chat:edit
#
# Nick do bot (minúsculas)
TWITCH_USERNAME=meubot
# OAuth token (começa com oauth:...)
TWITCH_OAUTH=oauth:cole_o_token_aqui
# Canal da live (sem #, minúsculas) — o teu nick de streamer
TWITCH_CHANNEL=meucanal

# Prefixo dos comandos
COMMAND_PREFIX=!

# Mensagem ao conectar (vazio = mensagem bonita padrão). {jogo} = jogo atual
# JOIN_MESSAGE=✦ Live no ar · {jogo} · !comandos
# SILENT_JOIN=1

# Cooldown global entre respostas do mesmo comando (ms)
COMMAND_COOLDOWN_MS=3000

# 1 = cumprimenta a 1ª mensagem de cada viewer (barulhento)
# FIRST_CHAT_GREET=0

# Tema de cores do terminal (chat Twitch não pinta)
# coral = Morgana (default) | void = abismo | pale = corte pálida | moss = greenpath
# LIVEBOT_THEME=coral

# ── OBS Studio (opcional) ─────────────────────────────────
# OBS → Ferramentas → WebSocket Server Settings → Enable
# OBS_ENABLED=1
# OBS_URL=ws://127.0.0.1:4455
# OBS_PASSWORD=senha_do_websocket
# Nome da source de texto no OBS (opcional) p/ mostrar o jogo
# OBS_GAME_TEXT_SOURCE=TextoJogo
# Mapa jogo→cena: data/obs-scenes.json
