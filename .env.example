# ── Twitch ──────────────────────────────────────────────
TWITCH_USERNAME=meubot
TWITCH_OAUTH=oauth:cole_o_token_aqui
TWITCH_CHANNEL=meucanal

COMMAND_PREFIX=!

# JOIN_MESSAGE=✦ Live no ar · {jogo} · !comandos
# SILENT_JOIN=1

# Cooldown global do mesmo comando (ms)
COMMAND_COOLDOWN_MS=3000
# Cooldown por utilizador+comando (ms) — 0 desliga
USER_COOLDOWN_MS=5000

# 1 = cumprimenta 1ª msg de cada viewer (welcome clássico)
# FIRST_CHAT_GREET=0
# Visitantes (Xª visita) — default ligado; 0 desliga
# VISITOR_GREET=1
# VISITOR_ONLY_RETURN=1   # só anuncia revisitas (não a 1ª)

# LIVEBOT_THEME=coral

# ── API Twitch (polls, predictions, !so com jogo, follows) ──
# App: https://dev.twitch.tv/console
# TWITCH_CLIENT_ID=xxxxxxxx
# Scopes úteis no token (streamer ou bot mod):
#   chat:read chat:edit
#   moderator:read:followers
#   channel:manage:polls
#   channel:manage:predictions
# ALERTS_FOLLOW=0
# POLL_DURATION_SEC=60
# PRED_DURATION_SEC=60

# ── PIX / doações ───────────────────────────────────────
# PIX_KEY=sua_chave_ou_https://livepix.gg/teuuser
# ALERTS_DONATION_AUTO=0
# DONATION_THANK_COOLDOWN_MS=60000
# Webhook local (tunnel/ngrok → LivePix se suportar URL)
# LIVEPIX_WEBHOOK_PORT=8787
# LIVEPIX_WEBHOOK_SECRET=opcional
# LIVEPIX_ANNOUNCE_META=1   # anuncia meta após doação no webhook

# ── Clip reminder ───────────────────────────────────────
# CLIP_REMINDER=0
# CLIP_REMINDER_MS=1800000   # 30 min
# CLIP_REMINDER_MSG=Clipa o momento se curtiu! 🎬

# ── Dashboard terminal + fim de sessão ──────────────────
# DASHBOARD=0
# DASHBOARD_MS=15000
# SESSION_SUMMARY_CHAT=1   # manda resumo no chat ao sair (Ctrl+C)

# ── OBS (opcional) ──────────────────────────────────────
# OBS_ENABLED=1
# OBS_URL=ws://127.0.0.1:4455
# OBS_PASSWORD=senha_do_websocket
# OBS_GAME_TEXT_SOURCE=TextoJogo
